pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Select Terraform action'
        )
    }

    environment {
        AWS_DEFAULT_REGION = "us-east-1"
        TF_IN_AUTOMATION   = "true"
        TF_INPUT           = "false"
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo '📦 Cloning Git repository...'
                checkout scm
            }
        }

        stage('Configure AWS Credentials') {
            steps {
                script {
                    // Load AWS credentials from Jenkins credentials store
                    withCredentials([
                        string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                        string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
                        string(credentialsId: 'aws-session-token', variable: 'AWS_SESSION_TOKEN')
                    ]) {
                        sh '''
                            echo "🔐 Configuring AWS credentials..."
                            
                            # Create .aws directory
                            mkdir -p ~/.aws
                            
                            # Create credentials file
                            cat > ~/.aws/credentials << EOF
[default]
aws_access_key_id = ${AWS_ACCESS_KEY_ID}
aws_secret_access_key = ${AWS_SECRET_ACCESS_KEY}
aws_session_token = ${AWS_SESSION_TOKEN}
EOF
                            
                            # Create config file
                            cat > ~/.aws/config << EOF
[default]
region = us-east-1
output = json
EOF
                            
                            # Set permissions
                            chmod 600 ~/.aws/credentials
                            chmod 600 ~/.aws/config
                            
                            echo "✅ AWS credentials configured"
                        '''
                    }
                }
            }
        }

        stage('Verify AWS Credentials') {
            steps {
                sh '''
                    echo "======================================"
                    echo "VERIFYING AWS CREDENTIALS"
                    echo "======================================"
                    echo ""
                    
                    echo "🧪 Testing AWS credentials..."
                    aws sts get-caller-identity || {
                        echo ""
                        echo "❌ AWS credentials test failed"
                        echo "Please check your credentials in Jenkins"
                        exit 1
                    }
                    
                    echo ""
                    echo "✅ AWS credentials are valid"
                    echo "======================================"
                '''
            }
        }

        stage('Environment Check') {
            steps {
                script {
                    sh '''
                        echo ""
                        echo "======================================"
                        echo "ENVIRONMENT INFORMATION"
                        echo "======================================"
                        echo ""
                        echo "🔧 Terraform Version:"
                        terraform --version
                        echo ""
                        echo "☁️  AWS Identity:"
                        aws sts get-caller-identity
                        echo ""
                        echo "🌍 AWS Region: $AWS_DEFAULT_REGION"
                        echo ""
                        echo "⚠️  State Management: LOCAL (S3 blocked in AWS Academy)"
                        echo "📁 State File: ./terraform.tfstate"
                        echo ""
                        echo "======================================"
                    '''
                }
            }
        }

        stage('Remove S3 Backend') {
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo "🧹 Removing S3 backend configuration..."
                        
                        # Remove backend.tf if it exists
                        if [ -f "backend.tf" ]; then
                            echo "  ✗ Found backend.tf - removing it"
                            rm -f backend.tf
                        else
                            echo "  ✓ No backend.tf found (good!)"
                        fi
                        
                        # Clean up any previous terraform state
                        rm -rf .terraform
                        rm -f .terraform.lock.hcl
                        
                        echo "✅ Ready for local state"
                    '''
                }
            }
        }

        stage('Terraform init') {
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo "🔄 Initializing Terraform with LOCAL backend..."
                        terraform init
                        echo "✅ Terraform initialized with local state"
                    '''
                }
            }
        }

        stage('Terraform validate') {
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo "✓ Validating Terraform configuration..."
                        terraform validate
                        echo "✅ Configuration is valid"
                    '''
                }
            }
        }

        stage('Terraform format check') {
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo "📝 Checking Terraform formatting..."
                        terraform fmt -check -recursive || echo "⚠️  Some files need formatting"
                    '''
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir('eks-terraform') {
                    script {
                        echo "📋 Creating Terraform execution plan..."
                        if (params.ACTION == 'destroy') {
                            sh 'terraform plan -destroy -out=tfplan'
                        } else {
                            sh 'terraform plan -out=tfplan'
                        }
                        
                        // Generate human-readable plan
                        sh 'terraform show -no-color tfplan > tfplan.txt'
                        
                        // Archive the plan
                        archiveArtifacts artifacts: 'tfplan.txt', allowEmptyArchive: false
                        
                        echo "✅ Plan created and archived"
                    }
                }
            }
        }

        stage('Review Plan') {
            steps {
                script {
                    echo "📊 Please review the Terraform plan in the archived artifacts"
                    echo "Action: ${params.ACTION}"
                }
            }
        }

        stage('Approval Gate') {
            steps {
                script {
                    def action = params.ACTION.toUpperCase()
                    timeout(time: 15, unit: 'MINUTES') {
                        input(
                            message: "⚠️  Do you want to ${action} the EKS cluster?",
                            ok: "Yes, proceed with ${action}"
                        )
                    }
                    echo "✅ Approved for ${action}"
                }
            }
        }

        stage('Terraform apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo "🚀 Applying Terraform changes..."
                        echo "⏳ This will take 10-15 minutes for EKS cluster creation..."
                        terraform apply -auto-approve tfplan
                        echo "✅ Infrastructure deployed successfully"
                    '''
                }
            }
        }

        stage('Terraform destroy') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo "🗑️  Destroying Terraform resources..."
                        echo "⏳ This will take 10-15 minutes..."
                        terraform apply -auto-approve tfplan
                        echo "✅ Infrastructure destroyed successfully"
                    '''
                }
            }
        }

        stage('Display Outputs') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir('eks-terraform') {
                    sh '''
                        echo ""
                        echo "======================================"
                        echo "📤 TERRAFORM OUTPUTS"
                        echo "======================================"
                        terraform output
                        echo ""
                        echo "======================================"
                        echo "🔧 KUBECTL CONFIGURATION"
                        echo "======================================"
                        echo ""
                        CLUSTER_NAME=$(terraform output -raw cluster_name 2>/dev/null || echo "MelCluster")
                        echo "To configure kubectl, run:"
                        echo ""
                        echo "  aws eks update-kubeconfig --region us-east-1 --name $CLUSTER_NAME"
                        echo ""
                        echo "======================================"
                    '''
                }
            }
        }

        stage('Backup State File') {
            steps {
                dir('eks-terraform') {
                    script {
                        // Archive the state file for backup
                        if (fileExists('terraform.tfstate')) {
                            echo "💾 Backing up Terraform state file..."
                            archiveArtifacts artifacts: 'terraform.tfstate', allowEmptyArchive: true
                            echo "✅ State file archived (can be restored from build artifacts)"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            dir('eks-terraform') {
                sh '''
                    echo "🧹 Cleaning up temporary files..."
                    rm -f tfplan tfplan.txt
                    
                    # Clean up credentials (security)
                    rm -rf ~/.aws
                '''
            }
        }
        
        success {
            script {
                echo ""
                echo "======================================"
                if (params.ACTION == 'apply') {
                    echo "✅ SUCCESS: EKS cluster deployed!"
                    echo "======================================"
                    echo ""
                    echo "📝 Next steps:"
                    echo "  1. Configure kubectl:"
                    echo "     aws eks update-kubeconfig --region us-east-1 --name MelCluster"
                    echo ""
                    echo "  2. Verify cluster:"
                    echo "     kubectl get nodes"
                    echo "     kubectl get pods -A"
                    echo ""
                    echo "  3. State file backed up in build artifacts"
                    echo ""
                } else {
                    echo "✅ SUCCESS: EKS cluster destroyed!"
                    echo "======================================"
                }
            }
        }
        
        failure {
            echo ""
            echo "======================================"
            echo "❌ PIPELINE FAILED"
            echo "======================================"
            echo ""
            echo "Common issues:"
            echo ""
            echo "  ✗ AWS Credentials expired"
            echo "    → Update credentials in Jenkins:"
            echo "    → Manage Jenkins → Credentials"
            echo ""
            echo "  ✗ Duplicate variables"
            echo "    → Variables should be in variables.tf only"
            echo ""
            echo "  ✗ VPC/Subnet/SG not found"
            echo "    → Verify names in AWS Console"
            echo "    → Lab-VPC, Public-Subnet-1, Public-Subnet-2, Jumphost-sg"
            echo ""
            echo "  ✗ IAM permissions"
            echo "    → Verify LabRole has EKS permissions"
            echo ""
            echo "📋 Check the build logs above for details"
            echo "======================================"
        }
        
        cleanup {
            echo "🧹 Final cleanup completed"
        }
    }
}
