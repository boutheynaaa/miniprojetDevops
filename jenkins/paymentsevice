pipeline {
    agent any

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master',
                    url: 'gitttttttt link'
            }
        }

        stage('Docker Image Build') {
            steps {
                script {
                    dir('payment') {
                        sh 'docker system prune -f'
                        sh 'docker container prune -f'
                        sh 'docker build -t payment .'
                    }
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                script {
                    sh '''
                    aws ecr get-login-password --region us-east-1 \
                    | docker login --username AWS --password-stdin 242201296943.dkr.ecr.us-east-1.amazonaws.com

                    docker tag payment:latest 242201296943.dkr.ecr.us-east-1.amazonaws.com/payment:${BUILD_NUMBER}

                    docker push 242201296943.dkr.ecr.us-east-1.amazonaws.com/payment:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Update Kubernetes Deployment') {
            environment {
                GIT_REPO_NAME = "Microservices-E-Commerce-eks-project"
                GIT_EMAIL = "Yaswanth.arumulla@gmail.com"
                GIT_USER_NAME = "arumullayaswanth"

                IMAGE_NAME = "payment"
                REPO_URL = "242201296943.dkr.ecr.us-east-1.amazonaws.com/payment"
                YAML_FILE = "payment.yaml"
            }

            steps {
                dir('kubernetes-files') {
                    withCredentials([string(credentialsId: 'my-git-pattoken', variable: 'git_token')]) {
                        sh '''
                        git config user.email "${GIT_EMAIL}"
                        git config user.name "${GIT_USER_NAME}"

                        sed -i "s#image:.*#image: ${REPO_URL}:${BUILD_NUMBER}#g" ${YAML_FILE}

                        git add .
                        git commit -m "Update payment image to version ${BUILD_NUMBER}"
                        git push https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:master
                        '''
                    }
                }
            }
        }
    }
}